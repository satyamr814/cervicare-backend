# ============================================================
#  CerviCare Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file to version control.
# ============================================================

# ─── Server ─────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000

# Set to "production" on live servers, "development" locally
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string
# Local example:  postgresql://user:password@localhost:5432/cervicare
# Neon example:   postgresql://user:password@ep-xxx.neon.tech/cervicare?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/cervicare

# ─── Authentication ─────────────────────────────────────────
# Long, random secret for signing JWT tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string_here

# JWT token expiry duration (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# bcrypt salt rounds — higher = more secure but slower (12 is a good default)
BCRYPT_ROUNDS=12

# ─── Admin ──────────────────────────────────────────────────
# Secret key required in X-Admin-Key header for admin endpoints
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=replace_with_a_strong_admin_secret_key

# ─── CORS ───────────────────────────────────────────────────
# Allowed origin URL for cross-origin requests
# Use "*" to allow all origins (development only)
# Use your frontend URL in production, e.g. https://cervicare.vercel.app
CORS_ORIGIN=*

# ─── Google Sheets Integration (Optional) ───────────────────
# Used for logging user actions and CRM data to a Google Sheet
# Leave these empty to disable Google Sheets logging gracefully

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=

# Service account email from Google Cloud Console
GOOGLE_CLIENT_EMAIL=

# Service account private key (include the full key with newlines as \n)
GOOGLE_PRIVATE_KEY=

# ─── Rate Limiting ──────────────────────────────────────────
# Max number of requests per window per IP on auth routes (default 10)
AUTH_RATE_LIMIT=10

# Max number of requests per window per IP on general API routes (default 100)
API_RATE_LIMIT=100

# Rate limit window in milliseconds (default 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
